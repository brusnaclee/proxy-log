# Server Configuration
PORT=3000
DASHBOARD_PORT=5173

# Token statistics multiplier (applied to ALL stats at read time).
# Scales displayed input/output token counts and derived costs.
# Unset / empty / 0 / invalid  -> 1x (no change, original numbers).
# Example: INPUT_TOKEN_MULTIPLIER=2 doubles all input token stats.
INPUT_TOKEN_MULTIPLIER=2
OUTPUT_TOKEN_MULTIPLIER=5

# Monthly Recap (Wrapped)
# System API key used to generate per-user recap narratives via the auto model
# (must be a valid proxy API key; recap generation runs under this key).
RECAP_API_KEY=
# Channel for daily recap debug posts (separate from the public tokito channel).
RECAP_DEBUG_CHANNEL_ID=1507648716847190088
# Public base URL used to build recap links (https://api.tokito.xyz/recap/{name}).
RECAP_PUBLIC_BASE_URL=https://api.tokito.xyz

# Database (PostgreSQL)
DATABASE_URL=
# Session secret (change this to a random string in production!)
SESSION_SECRET=change-me-to-a-random-secret-string

# Default admin password (only used on first run if no admin exists)
DEFAULT_ADMIN_PASSWORD=admin

# Internal bot -> proxy authentication
INTERNAL_API_SECRET=change-me-in-production
PROXY_INTERNAL_BASE_URL=http://localhost:3000
PROXY_PUBLIC_BASE_URL=http://localhost:3000

# Discord Bot (agverif integration)
BOT_TOKEN=

# Model monitoring (tokito_check integration)
TOKITO_API_KEY=
TOKITO_CHANNEL_ID=
TOKITO_BASE_URL=
TOKITO_STATUS_INTERVAL_MS=3600000
TOKITO_LATENCY_INTERVAL_MS=600000

AGVERIF_CHANNEL_ID=
AGVERIF_ENABLED=true
REQUIRED_ROLE_ID=
OWNER_GROUPY_ROLE_ID=
VERIFIED_ROLE_ID=

# Gemini verification (optional)
GOOGLE_API_KEY=
GOOGLE_API_KEY1=
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=
GOOGLE_API_KEY4=
GOOGLE_API_KEY5=
GOOGLE_API_KEY6=
GOOGLE_API_KEY7=
GOOGLE_API_KEY8=
GOOGLE_API_KEY9=
GOOGLE_API_KEY10=
GOOGLE_API_KEY11=
VERIF_AUTO=false

# 9Router Quota Guard
NINEROUTER_BASE_URL=https://
NINEROUTER_PASSWORD=
NINEROUTER_QUOTA_THRESHOLD=20
NINEROUTER_POLL_INTERVAL_MS=60000
NINEROUTER_EXCLUDED_PROVIDERS=glm
